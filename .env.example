# Copia este fichero a .env y rellénalo. El .env NUNCA se sube a git.

# --- Panel ---
# Contraseña del panel. Mejor un hash bcrypt que texto plano:
#   docker compose run --rm --no-deps --entrypoint php web hash_password.php 'tu-contraseña'
# y pega la línea que imprime TAL CUAL, con las comillas simples (sin ellas
# docker compose interpreta los $ del hash y lo rompe).
ADMIN_PASSWORD=

# Nombre que se muestra en el panel y en el mensaje del formulario.
NOMBRE_ALOJAMIENTO=Mi alojamiento

# Mensaje que se copia para mandar al huésped (opcional; si se deja vacío se
# usa uno por defecto). Admite {nombre}, {alojamiento} y {enlace}.
MENSAJE_FORMULARIO=

# Zona horaria: las horas del sync automático (02, 08, 14 y 20 h) son locales.
TZ=Europe/Madrid

# --- PocketBase ---
# Desde el contenedor web, por el nombre del servicio.
POCKETBASE_URL=http://pocketbase:80
# Superusuario de PocketBase (créalo en http://<servidor>:8090/_/ la primera vez).
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Holidu ---
HOLIDU_EMAIL=
HOLIDU_PASSWORD=

# --- Opcional ---
# Clave para que otro servicio (un bot, un cron externo...) pueda lanzar el
# sync con la cabecera X-API-Key en vez de con sesión de panel. Vacía = desactivado.
# Genera una con: openssl rand -hex 32
AGENTE_API_KEY=
